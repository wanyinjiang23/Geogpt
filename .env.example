# Offline mode uses no credentials. Environment files are not auto-loaded.
GEOSITE_OUTPUT_DIR=outputs
# Opt-in LLM CLI only; not used by offline mode or the Web UI.
GEOSITE_API_KEY=
GEOSITE_MODEL=
GEOSITE_API_BASE=https://api.openai.com/v1
# Legacy modules only; requires restored plaintext source and separate dependencies.
GEOGPT_API_KEY=
GEOGPT_API_BASE=
GEOGPT_KNOWLEDGE_FILE=
# GeoRetail optional online parser; never put actual secrets in source control.
# The application reads environment variables; it does not auto-load this file.
GEORETAIL_API_KEY=
GEORETAIL_MODEL=
GEORETAIL_API_BASE=https://api.openai.com/v1
